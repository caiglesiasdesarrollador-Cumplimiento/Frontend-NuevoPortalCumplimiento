{
  "name": "angular",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "config:env": "ts-node ./src/app/core/setenv.config.ts",
    "config:env:dev": "npm run config:env -- --environment=dev",
    "config:env:stage": "npm run config:env -- --environment=stage",
    "config:env:prod": "npm run config:env -- --environment=prod",
    "serve": "ng serve --port 4215",
    "start": "npm run config:env:dev && npm run serve",
    "build": "ng build --configuration",
    "build:dev": "npm run config:env:dev && npm run build development",
    "build:stage": "npm run config:env:stage && npm run build stage",
    "build:prod": "npm run config:env:prod && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "prepare": "husky install"
  },
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@fortawesome/fontawesome-pro": "^6.5.2",
    "chart.js": "^4.4.2",
    "primeng": "15.4.1",
    "rxjs": "^7.5.5",
    "tech-block-lib": "15.0.0",
    "tslib": "^2.4.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "~15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.6",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "dotenv-webpack": "^8.0.1",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.0",
    "jest": "^29.5.0",
    "jest-preset-angular": "13.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.8.2",
    "yargs": "^17.7.2"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.{.ts,html,scss,md,json}": "prettier --write"
  }
}
