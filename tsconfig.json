{
  "compileOnSave": false, // No recompilar automáticamente al guardar archivos
  "compilerOptions": {
    "baseUrl": "./", // Base de la URL para la resolución de módulos
    "outDir": "./dist/out-tsc", // Directorio de salida para los archivos compilados
    "sourceMap": true, // Generar archivos sourceMap para la depuración
    "declaration": false, // No generar archivos de declaración (.d.ts)
    "downlevelIteration": true, // Soporte para iteración en versiones anteriores de ES
    "experimentalDecorators": true, // Habilitar decoradores experimentales
    "module": "es2020", // Especifica el módulo utilizado
    "moduleResolution": "node", // Estrategia de resolución de módulos
    "importHelpers": true, // Importar helpers desde tslib
    "target": "es2022", // Especifica la versión de ECMAScript para la compilación
    "typeRoots": ["node_modules/@types"], // Directorios donde buscar tipos
    "lib": ["es2022", "dom"], // Librerías incluidas en el entorno de compilación
    "types": ["jest", "node"], // Tipos adicionales incluidos en el proyecto
    "paths": {
      "@app/*": ["src/app/*"], // Alias para rutas dentro del proyecto
      "@environment": ["src/environments/environment"]
    },
    "strict": true, // Habilita todas las verificaciones estrictas
    "noImplicitAny": true, // Asegura que no haya tipos 'any' implícitos
    "strictNullChecks": true, // Manejo explícito de null y undefined
    "strictFunctionTypes": true, // Tipos estrictos para funciones
    "noImplicitReturns": true, // Error si una función no tiene un valor de retorno explícito
    "noFallthroughCasesInSwitch": true, // Previene el fallo en casos de switch
    "noUnusedLocals": true, // Detecta variables locales no utilizadas
    "noUnusedParameters": true, // Detecta parámetros de funciones no utilizados
    "skipLibCheck": true, // Omite la comprobación de tipo de archivos de declaración
    "noImplicitThis": true, // Asegura que 'this' esté correctamente tipificado
    "resolveJsonModule": true // Permite la importación de archivos JSON
  },
  "angularCompilerOptions": {
    "enableIvy": true, // Habilita el motor de compilación Ivy
    "fullTemplateTypeCheck": true, // Habilita la verificación completa de tipos en templates
    "strictInjectionParameters": true, // Verificación estricta de parámetros de inyección
    "enableI18nLegacyMessageIdFormat": false, // Deshabilita el formato de ID de mensaje i18n legado
    "strictTemplates": true // Verificación estricta de tipos en templates
  }
}
