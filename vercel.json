{
  "version": 2,
  "buildCommand": "npm run config:env:prod && npm run build -- --configuration=production",
  "outputDirectory": "dist",
  "installCommand": "bash setup-npmrc.sh && npm install",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
