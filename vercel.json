{
  "version": 2,
  "buildCommand": "npm run config:env:prod && npm run build -- --configuration=production",
  "outputDirectory": "dist",
  "installCommand": "echo 'registry=https://segurosbolivar.jfrog.io/artifactory/api/npm/bolivar-npm-core-web-kit-components-lib-prod-virtual/\n//segurosbolivar.jfrog.io/artifactory/api/npm/bolivar-npm-core-web-kit-components-lib-prod-virtual/:_authToken='$JFROG_AUTH_TOKEN'\nalways-auth=true' > .npmrc && npm install",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
